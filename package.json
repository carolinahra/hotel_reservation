{
  "name": "hotel_reservation",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "prestart": "npm run build",
    "start": "node --env-file=.env dist/bootstrap.js",
    "dev": "ts-node -r tsconfig-paths/register src/bootstrap.ts",
    "pretest": "npm run build",
    "test": "node --enable-source-maps --test './**/*.spec.js'",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info './**/*.spec.js'",
    "pretest:e2e": "npm run build",
    "pretest:e2e-only": "npm run build",
    "test:e2e": "node --enable-source-maps --test './**/*.e2e-spec.js'",
    "test:e2e-only": "node --enable-source-maps --test --test-only './**/*.e2e-spec.js'"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/nodemailer": "^7.0.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "kysely": "^0.28.7",
    "mysql2": "^3.14.1",
    "nodemailer": "^7.0.10",
    "save-dev": "^0.0.1-security",
    "uuid": "^13.0.0"
  }
}
